# FinGuard configuration. Copy to .env. Everything works with the defaults in mock mode.
FINGUARD_ADMIN_PASSWORD=change-me-admin
FINGUARD_SESSION_SECRET=change-me-long-random-string
FINGUARD_DB_PATH=./data/runtime/finguard.db
# Provider: mock (offline, deterministic) | anthropic | openai
FINGUARD_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FINGUARD_DEFAULT_MODEL=
# Engine: nemo (NeMo Guardrails rails run the checks) | native (direct calls)
FINGUARD_ENGINE=nemo
# Store raw (unredacted) input in the audit log? Default false = redact before storage.
FINGUARD_STORE_RAW=false
# Optional model-based judge for injection / MNPI (off by default, never used in mock mode)
FINGUARD_MODEL_JUDGE=false
FINGUARD_USE_PRESIDIO=false
# Base URL shown in the Connect drawer (blank = browser origin)
FINGUARD_PUBLIC_URL=
FINGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
